# Preserve pinned asset hashes and binary payloads across Windows checkouts.
simulator/models/** -text -diff
simulator/models/custom_gripper/*.json text eol=lf
simulator/models/custom_gripper/*.py text eol=lf diff
simulator/models/custom_gripper/*.md text eol=lf diff
simulator/models/upstream/** -text -diff
simulator/vendor/** -text -diff
*.stl binary
*.step binary
*.stp binary
*.docx binary

# Relocated mechanical payloads keep source hashes on Windows.
mechanical/** -text -diff
mechanical/**/*.py text eol=lf diff
mechanical/**/*.md text eol=lf diff
mechanical/upstream/community_robot_arm/** -text -diff
*.SLDPRT binary
*.SLDASM binary
*.3mf binary
